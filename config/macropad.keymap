#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/via_macro.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// Named so the configurator can find it and offer scrolling on the knob.
&msc {
    display-name = "Mouse Scroll";
};

/ {
    behaviors {
        // Encoder defaults; each layer can be overridden at runtime.
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_track: rsr_track {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_NEXT>;
            ccw-binding = <&kp C_PREV>;
        };
    };

    macros {
        // Leaves the PC disconnected: the active profile always reconnects, so move to
        // spare profile 2 first, then drop profile 0. Fn + BT_SEL 0 reconnects.
        bt_off: bt_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Bluetooth Off";
            wait-ms = <30>;
            bindings = <&bt BT_SEL 2>, <&bt BT_DISC 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                         &kp F13  &kp F14
                &kp F15  &kp F16  &kp F17  &kp F18
                &kp F19  &kp F20  &kp F21  &kp F22
                         &kp PSCRN  &kp PAUSE_BREAK  &mo 1
            >;
            sensor-bindings = <&rsr_vol>;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                            &bt BT_SEL 0  &bt BT_SEL 1
                &bt BT_SEL 2  &bootloader   &bt BT_CLR   &out OUT_TOG
                &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD
                              &studio_unlock  &bt_off  &trans
            >;
            sensor-bindings = <&rsr_track>;
        };
    };
};
