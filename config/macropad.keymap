#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                         &kp F13  &kp F14
                &kp F15  &kp F16  &kp F17  &kp F18
                &kp F19  &kp F20  &kp F21  &kp F22
                         &kp F23  &kp F24  &lt 1 ENTER
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                            &bt BT_SEL 0  &bt BT_SEL 1
                &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR   &out OUT_TOG
                &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD
                              &bootloader  &studio_unlock  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV>;
        };
    };
};
