/*
 * Sony RMT-V501F TV remote, modes as on the original (src/tvremote_mode.c):
 *   switch TV                         layer 0: infrared, code set 0
 *   switch DVD/VIDEO, SELECT VIDEO    layer 1: Bluetooth keyboard and media keys
 *   switch DVD/VIDEO, SELECT DVD      layer 2: infrared like TV, code set 1
 * Hold POWER while putting the batteries in (or plugging USB) for the
 * flashing bootloader.
 *
 * Generated by bt-remote/pcb/make_zmk.py: edit the tables there, not here.
 */

#include <behaviors.dtsi>
#include <behaviors/ir.dtsi>
#include <behaviors/tvremote.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        tv_layer {
            display-name = "TV";
            bindings = <
                // row 0
                &ir IR_N1              // 1
                &tvsel TVSEL_DVD       // DVD
                &ir IR_EJECT           // EJECT
                &tvsel TVSEL_VIDEO     // VIDEO
                &ir IR_GUIDE           // VCR PLUS
                &ir IR_POWER           // POWER
                &ir IR_CH_UP           // CH+

                // row 1
                &ir IR_N4              // 4
                &ir IR_N5              // 5
                &ir IR_N2              // 2
                &ir IR_N6              // 6
                &ir IR_N3              // 3
                &ir IR_VOL_UP          // VOL+
                &ir IR_CH_DN           // CH-

                // row 2
                &ir IR_EXIT            // CLEAR
                &ir IR_N7              // 7
                &ir IR_N0              // 0
                &ir IR_N8              // 8
                &ir IR_OK              // ENTER
                &ir IR_N9              // 9
                &ir IR_VOL_DN          // VOL-

                // row 3
                &ir IR_AUDIO           // AUDIO
                &ir IR_MENU            // SET UP
                &ir IR_SUBTITLE        // SUBTITLE
                &ir IR_MODE            // ANGLE
                &ir IR_RED             // REPEAT
                &ir IR_INPUT           // TV/VIDEO
                &ir IR_MUTE            // ZOOM

                // row 4
                &ir IR_REC             // REC
                &ir IR_GREEN           // REPEAT2
                &ir IR_YELLOW          // SKIP
                &ir IR_REW             // SCAN REW
                &ir IR_BLUE            // SURROUND
                &ir IR_FF              // SCAN F.F
                &ir IR_INPUT           // INPUT

                // row 5
                &ir IR_PLAY            // PLAY
                &ir IR_FAN             // SP/EP
                &ir IR_UP              // UP
                &ir IR_PAUSE           // PAUSE
                &ir IR_PREV            // PREV
                &ir IR_STOP            // STOP
                &ir IR_NEXT            // NEXT

                // row 6
                &ir IR_INFO            // DISPLAY
                &ir IR_RIGHT           // RIGHT
                &ir IR_HOME            // TOP MENU
                &ir IR_DOWN            // DOWN
                &ir IR_OK              // SELECT
                &ir IR_LEFT            // LEFT
                &ir IR_BACK            // RETURN

                // row 7
                &ir IR_MENU            // MENU
            >;
        };

        video_layer {
            display-name = "VIDEO";
            bindings = <
                // row 0
                &kp N1                 // 1
                &tvsel TVSEL_DVD       // DVD
                &kp C_EJECT            // EJECT
                &tvsel TVSEL_VIDEO     // VIDEO
                &bt BT_SEL 0           // VCR PLUS
                &kp C_POWER            // POWER
                &kp PG_UP              // CH+

                // row 1
                &kp N4                 // 4
                &kp N5                 // 5
                &kp N2                 // 2
                &kp N6                 // 6
                &kp N3                 // 3
                &kp C_VOL_UP           // VOL+
                &kp PG_DN              // CH-

                // row 2
                &kp BSPC               // CLEAR
                &kp N7                 // 7
                &kp N0                 // 0
                &kp N8                 // 8
                &kp RET                // ENTER
                &kp N9                 // 9
                &kp C_VOL_DN           // VOL-

                // row 3
                &bt BT_SEL 1           // AUDIO
                &studio_unlock         // SET UP
                &bt BT_CLR             // SUBTITLE
                &bt BT_SEL 2           // ANGLE
                &none                  // REPEAT
                &kp TAB                // TV/VIDEO
                &kp C_MUTE             // ZOOM

                // row 4
                &none                  // REC
                &none                  // REPEAT2
                &none                  // SKIP
                &kp C_RW               // SCAN REW
                &none                  // SURROUND
                &kp C_FF               // SCAN F.F
                &none                  // INPUT

                // row 5
                &kp C_PP               // PLAY
                &kp SPACE              // SP/EP
                &kp UP                 // UP
                &kp C_PP               // PAUSE
                &kp C_PREV             // PREV
                &kp C_STOP             // STOP
                &kp C_NEXT             // NEXT

                // row 6
                &kp C_AC_SEARCH        // DISPLAY
                &kp RIGHT              // RIGHT
                &kp C_AC_HOME          // TOP MENU
                &kp DOWN               // DOWN
                &kp RET                // SELECT
                &kp LEFT               // LEFT
                &kp C_AC_BACK          // RETURN

                // row 7
                &kp K_CMENU            // MENU
            >;
        };

        dvd_layer {
            display-name = "DVD";
            bindings = <
                // row 0
                &trans                 // 1
                &trans                 // DVD
                &trans                 // EJECT
                &trans                 // VIDEO
                &trans                 // VCR PLUS
                &trans                 // POWER
                &trans                 // CH+

                // row 1
                &trans                 // 4
                &trans                 // 5
                &trans                 // 2
                &trans                 // 6
                &trans                 // 3
                &trans                 // VOL+
                &trans                 // CH-

                // row 2
                &trans                 // CLEAR
                &trans                 // 7
                &trans                 // 0
                &trans                 // 8
                &trans                 // ENTER
                &trans                 // 9
                &trans                 // VOL-

                // row 3
                &trans                 // AUDIO
                &trans                 // SET UP
                &trans                 // SUBTITLE
                &trans                 // ANGLE
                &trans                 // REPEAT
                &trans                 // TV/VIDEO
                &trans                 // ZOOM

                // row 4
                &trans                 // REC
                &trans                 // REPEAT2
                &trans                 // SKIP
                &trans                 // SCAN REW
                &trans                 // SURROUND
                &trans                 // SCAN F.F
                &trans                 // INPUT

                // row 5
                &trans                 // PLAY
                &trans                 // SP/EP
                &trans                 // UP
                &trans                 // PAUSE
                &trans                 // PREV
                &trans                 // STOP
                &trans                 // NEXT

                // row 6
                &trans                 // DISPLAY
                &trans                 // RIGHT
                &trans                 // TOP MENU
                &trans                 // DOWN
                &trans                 // SELECT
                &trans                 // LEFT
                &trans                 // RETURN

                // row 7
                &trans                 // MENU
            >;
        };
    };
};
