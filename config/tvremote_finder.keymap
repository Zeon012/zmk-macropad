    keymap {
        compatible = "zmk,keymap";

        finder {
            bindings = <
                // row 0
                &rc00    // 1
                &rc01    // DVD
                &rc02    // EJECT
                &rc03    // VIDEO
                &rc04    // VCR PLUS
                &rc05    // POWER
                &rc06    // CH+

                // row 1
                &rc10    // 4
                &rc11    // 5
                &rc12    // 2
                &rc13    // 6
