/*
 * Matrix finder: each button types its row and column ("r3c5 "), so the real
 * keymap can be laid out. Plug in over USB, open Notepad, press every button.
 */

#include <behaviors.dtsi>
#include <behaviors/ir.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        rc00: rc00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp R &kp N0 &kp C &kp N0 &kp SPACE>;
        };
