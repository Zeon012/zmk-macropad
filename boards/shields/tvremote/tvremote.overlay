/*
 * Sony RMT-V501F shell with the replacement PCB (bt-remote/pcb, ordered
 * 2026-11-13): SuperMini nRF52840 (nice!nano v2 pinout), 50 keys in an 8 x 7
 * matrix with one 1N4148WS per key (COL2ROW), IR LED driven by an NPN on 101,
 * 3-position slide switch on 102 (TV) / 107 (VIDEO) with DVD = neither, and a
 * nice!view on the standard pins (MOSI 017, SCK 020, CS 006: build with
 * nice_view_adapter nice_view).
 *
 * Generated by bt-remote/pcb/make_zmk.py from matrix.json and layout.json.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/* Rows 010 and 009 are the nRF52840's NFC pins. */
&uicr {
    nfct-pins-as-gpios;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    zephyr,user {
        ir-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
        /* SW1 common is GND. The pull-ups are only switched on while the
         * switch is read (src/tvremote_mode.c), so a closed switch draws
         * nothing between reads. */
        mode-tv-gpios = <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        mode-video-gpios = <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&gpio0 8 GPIO_ACTIVE_HIGH>   // col 0, SuperMini 008
            , <&gpio0 22 GPIO_ACTIVE_HIGH>   // col 1, SuperMini 022
            , <&gpio0 24 GPIO_ACTIVE_HIGH>   // col 2, SuperMini 024
            , <&gpio1 0 GPIO_ACTIVE_HIGH>   // col 3, SuperMini 100
            , <&gpio0 11 GPIO_ACTIVE_HIGH>   // col 4, SuperMini 011
            , <&gpio1 4 GPIO_ACTIVE_HIGH>   // col 5, SuperMini 104
            , <&gpio1 6 GPIO_ACTIVE_HIGH>   // col 6, SuperMini 106
            ;

        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 0, SuperMini 031
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 1, SuperMini 029
            , <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 2, SuperMini 002
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 3, SuperMini 115
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 4, SuperMini 113
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 5, SuperMini 111
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 6, SuperMini 010
            , <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 7, SuperMini 009
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <8>;
        map = <RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5) RC(6,6) RC(7,0)>;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Sony RMT-V501F";
        transform = <&default_transform>;
        keys
            = <&key_physical_attrs 80 80   36   277 0 0 0>   // 1
            , <&key_physical_attrs 80 80   38   177 0 0 0>   // DVD
            , <&key_physical_attrs 80 80   60    28 0 0 0>   // EJECT
            , <&key_physical_attrs 80 80  139   179 0 0 0>   // VIDEO
            , <&key_physical_attrs 80 80  238   181 0 0 0>   // VCR PLUS
            , <&key_physical_attrs 80 80  320    32 0 0 0>   // POWER
            , <&key_physical_attrs 80 80  338   182 0 0 0>   // CH+
            , <&key_physical_attrs 80 80   35   377 0 0 0>   // 4
            , <&key_physical_attrs 80 80  135   379 0 0 0>   // 5
            , <&key_physical_attrs 80 80  136   279 0 0 0>   // 2
            , <&key_physical_attrs 80 80  235   381 0 0 0>   // 6
            , <&key_physical_attrs 80 80  236   281 0 0 0>   // 3
            , <&key_physical_attrs 80 80  335   382 0 0 0>   // VOL+
            , <&key_physical_attrs 80 80  337   282 0 0 0>   // CH-
            , <&key_physical_attrs 80 80   33   577 0 0 0>   // CLEAR
            , <&key_physical_attrs 80 80   34   477 0 0 0>   // 7
            , <&key_physical_attrs 80 80  132   579 0 0 0>   // 0
            , <&key_physical_attrs 80 80  135   479 0 0 0>   // 8
            , <&key_physical_attrs 80 80  232   581 0 0 0>   // ENTER
            , <&key_physical_attrs 80 80  234   481 0 0 0>   // 9
            , <&key_physical_attrs 80 80  335   482 0 0 0>   // VOL-
            , <&key_physical_attrs 80 80   30   777 0 0 0>   // AUDIO
            , <&key_physical_attrs 80 80   31   677 0 0 0>   // SET UP
            , <&key_physical_attrs 80 80  130   779 0 0 0>   // SUBTITLE
            , <&key_physical_attrs 80 80  131   679 0 0 0>   // ANGLE
            , <&key_physical_attrs 80 80  230   681 0 0 0>   // REPEAT
            , <&key_physical_attrs 80 80  331   682 0 0 0>   // TV/VIDEO
            , <&key_physical_attrs 80 80  333   583 0 0 0>   // ZOOM
            , <&key_physical_attrs 80 80   26   980 0 0 0>   // REC
            , <&key_physical_attrs 80 80   28   877 0 0 0>   // REPEAT2
            , <&key_physical_attrs 80 80  129   879 0 0 0>   // SKIP
            , <&key_physical_attrs 80 80  228   881 0 0 0>   // SCAN REW
            , <&key_physical_attrs 80 80  229   781 0 0 0>   // SURROUND
            , <&key_physical_attrs 80 80  328   882 0 0 0>   // SCAN F.F
            , <&key_physical_attrs 80 80  329   782 0 0 0>   // INPUT
            , <&key_physical_attrs 80 80   45  1123 0 0 0>   // PLAY
            , <&key_physical_attrs 80 80  127   983 0 0 0>   // SP/EP
            , <&key_physical_attrs 80 80  174  1243 0 0 0>   // UP
            , <&key_physical_attrs 80 80  175  1126 0 0 0>   // PAUSE
            , <&key_physical_attrs 80 80  226   986 0 0 0>   // PREV
            , <&key_physical_attrs 80 80  304  1127 0 0 0>   // STOP
            , <&key_physical_attrs 80 80  327   987 0 0 0>   // NEXT
            , <&key_physical_attrs 80 80   12  1500 0 0 0>   // DISPLAY
            , <&key_physical_attrs 80 80   58  1355 0 0 0>   // RIGHT
            , <&key_physical_attrs 80 80  109  1558 0 0 0>   // TOP MENU
            , <&key_physical_attrs 80 80  170  1471 0 0 0>   // DOWN
            , <&key_physical_attrs 80 80  173  1355 0 0 0>   // SELECT
            , <&key_physical_attrs 80 80  285  1359 0 0 0>   // LEFT
            , <&key_physical_attrs 80 80  328  1505 0 0 0>   // RETURN
            , <&key_physical_attrs 80 80  229  1561 0 0 0>   // MENU
            ;
    };
};
