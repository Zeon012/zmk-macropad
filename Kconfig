config MACROPAD_LEDS
    bool "Macropad per-action LED effects"
    depends on !ZMK_RGB_UNDERGLOW
    select LED_STRIP
    select ZMK_LOW_PRIORITY_WORK_QUEUE
    help
      Drives the LED strip chosen as zmk,underglow with the per-key effects
      from the original macropad firmware. Replaces ZMK's RGB underglow.

if MACROPAD_LEDS

config MACROPAD_LEDS_BRIGHTNESS
    int "Global LED brightness in percent"
    range 1 100
    default 35
    help
      Scales every pixel. 23 LEDs at 100 % can draw well over the 500 mA a
      USB port supplies, so keep this low when powering the strip from USB.

config MACROPAD_LEDS_FRAME_MS
    int "Milliseconds between animation frames"
    range 10 200
    default 30

endif

config MACROPAD_STATUS_RPC
    bool "Expose battery and power status over the custom Studio RPC"
    depends on ZMK_STUDIO && ZMK_BATTERY_REPORTING
    default y
    help
      Registers the macropad__status custom subsystem, which the configurator
      reads to show the battery level over USB or Bluetooth.

config MACROPAD_STATUS_LED
    bool "Show Bluetooth and battery state on an RGB LED"
    depends on ZMK_BLE
    select PWM
    default y
    help
      Drives the status_led_red, status_led_green and status_led_blue PWM
      LEDs: a fast blink while the selected Bluetooth profile is waiting to be
      paired and a short flash every two seconds while a paired host is not
      connected; otherwise green on USB power and red on battery.

config MACROPAD_STATUS_LED_BRIGHTNESS
    int "Status LED brightness in percent"
    depends on MACROPAD_STATUS_LED
    range 1 100
    default 15

config MACROPAD_BT_LED
    bool "Show Bluetooth state on a single LED"
    depends on ZMK_BLE && !MACROPAD_STATUS_LED
    help
      For boards with no pins free for the RGB status LED. Blinks the LED
      named by bt-led-gpios in the zephyr,user node: fast while the selected
      profile is waiting to be paired, a short flash every two seconds while a
      paired host is not connected.

config MACROPAD_VIA
    bool "VIA compatibility over USB raw HID"
    depends on ZMK_USB && ZMK_KEYMAP_SETTINGS_STORAGE
    help
      Adds a raw HID interface on USB and answers the VIA app's protocol on
      it, so usevia.app can read and remap keys and the knob and edit VIA
      macros. Needs CONFIG_USB_HID_DEVICE_COUNT=2. See via/README.md.

if MACROPAD_VIA

config MACROPAD_VIA_REQUIRE_UNLOCK
    bool "Only accept VIA changes while ZMK Studio is unlocked"
    depends on ZMK_STUDIO
    default y
    help
      VIA has no lock of its own, so without this any program on the
      computer could remap the pad. Reading the keymap is always allowed.

config MACROPAD_VIA_MACRO_COUNT
    int "Number of VIA macros"
    range 1 128
    default 16

config MACROPAD_VIA_MACRO_BUFFER_SIZE
    int "Bytes for all VIA macros together"
    range 64 2048
    default 512

config MACROPAD_VIA_MACRO_TAP_MS
    int "Milliseconds between key events when playing a VIA macro"
    range 1 100
    default 10

endif

config MACROPAD_BOOT_KEY
    bool "Hold a key while powering up to enter the bootloader"
    select GPIO
    help
      Restarts into the UF2 bootloader when the key at
      MACROPAD_BOOT_KEY_ROW/COL (kscan row and column indexes) is held while
      the board starts, so new firmware can be flashed without reaching the
      reset pins. Assumes col2row diodes.

if MACROPAD_BOOT_KEY

config MACROPAD_BOOT_KEY_ROW
    int "Row index of the boot key"
    default 0

config MACROPAD_BOOT_KEY_COL
    int "Column index of the boot key"
    default 1

endif
